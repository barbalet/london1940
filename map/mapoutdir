#!/usr/bin/env bash

set -euo pipefail

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "usage: mapoutdir INPUT_DIR [OUTPUT_DIR]" >&2
    exit 2
fi
input_dir=$1
output_dir=${2:-results}
if [ ! -d "${input_dir}" ]; then
    echo "mapoutdir: not a directory: ${input_dir}" >&2
    exit 1
fi
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
map2json=${MAP2JSON:-${script_dir}/map2json}
if [ ! -x "${map2json}" ]; then
    map2json=$(command -v map2json || true)
fi
if [ -z "${map2json}" ] || [ ! -x "${map2json}" ]; then
    echo "mapoutdir: map2json is not built or installed" >&2
    exit 1
fi
mkdir -p "${output_dir}"
while IFS= read -r -d '' entry; do
    base=$(basename -- "${entry}" .png)
    "${map2json}" "${entry}" --output "${output_dir}/${base}.v1.json" \
        --work-dir "${output_dir}/.work"
done < <(find "${input_dir}" -type f -name '*.png' -print0 | sort -z)
rmdir "${output_dir}/.work" 2>/dev/null || true
